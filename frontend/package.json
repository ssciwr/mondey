{
	"name": "mondey-frontend-prototype",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"serve": "ws --port 5173 --directory build --spa index.html --rewrite '/api/(.*) -> http://localhost:8000/$1'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest --coverage",
		"test:ui": "pnpm exec playwright test tests/ui",
		"test:ui:dev": "pnpm exec playwright test tests/ui --ui",
		"test:e2e": "pnpm exec playwright test tests/e2e",
		"test:e2e:dev": "pnpm exec playwright test tests/e2e --ui",
		"test:e2e:dev:seq": "pnpm exec playwright test tests/e2e --ui --workers 1",
		"openapi-ts": "openapi-ts"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.99.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/file-saver": "^2.0.7",
		"@types/luxon": "^3.7.6",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.0.5",
		"flowbite": "^3.1.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "3.1.0",
		"jsdom": "^30.1.3",
		"local-web-server": "^5.4.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@unovis/ts": "1.7.1",
		"cdigit": "^5.0.1",
		"danfojs": "^1.1.2",
		"dompurify": "^3.4.17",
		"export-to-csv": "^1.5.0",
		"file-saver": "^2.0.5",
		"iso-639-1": "3.1.6",
		"luxon": "^3.7.2",
		"svelte-dnd-action": "^0.9.80",
		"wcag-contrast-utils": "^1.0.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.14.0"
}
